__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local environment configuration
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# Jupyter
.ipynb_checkpoints/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build/package output
build/
dist/
*.egg-info/

